{
  "name": "workout-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "generate-types": "wrangler types",
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "forbidden-scan": "node scripts/forbidden-feature-scan.mjs",
    "release-check": "npm run check && npm run forbidden-scan"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.116.0"
  }
}
